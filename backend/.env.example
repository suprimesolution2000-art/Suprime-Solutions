# Environment Mode: development | production | test
NODE_ENV=production

# Server Port (Render sets this automatically to 10000)
PORT=5000

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://admin_father:MySecurePass123@cluster0.abcde.mongodb.net/ss_supreme_solutions?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ss_supreme_solutions?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate strong random 64-char strings)
JWT_SECRET=ss_supreme_solutions_jwt_secret_change_in_production_2026
JWT_REFRESH_SECRET=ss_supreme_solutions_refresh_secret_change_in_production_2026

